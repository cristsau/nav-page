diff --git a/web-admin/src/lib/mount.ts b/web-admin/src/lib/mount.ts
new file mode 100644
index 0000000..d6adcb2
--- /dev/null
+++ b/web-admin/src/lib/mount.ts
@@ -0,0 +1,19 @@
+declare const __NAV_MONITOR_MOUNT__: string
+export const mount = typeof __NAV_MONITOR_MOUNT__ === "string" ? __NAV_MONITOR_MOUNT__ : ""
+export const embedded = mount !== ""
+export function hubPath(path: string): string {
+  return path.startsWith("/") && !path.startsWith("//") ? mount + path : path
+}
+export function localPath(path: string): string {
+  return mount && (path === mount || path.startsWith(mount + "/")) ? path.slice(mount.length) || "/" : path
+}
+export function notifyParent(type: "ready" | "auth-required") {
+  if (embedded && parent !== window) parent.postMessage({ type: `nav-monitor:${type}`, section: location.pathname.startsWith(`${mount}/admin`) ? "admin" : "overview" }, location.origin)
+}
+export function parentDark() { return embedded && parent !== window ? parent.document.documentElement.classList.contains("dark") : null }
+export function observeParentTheme(notify: () => void) {
+  if (!embedded || parent === window) return () => {}
+  const observer = new MutationObserver(notify)
+  observer.observe(parent.document.documentElement, { attributes: true, attributeFilter: ["class"] })
+  return () => observer.disconnect()
+}
