TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
VITE_TELEGRAM_ADMIN_CHAT_ID=
# Only enable the local Telegram proxy in a trusted development environment.
NAV_ENABLE_TELEGRAM_DEV_PROXY=false
VITE_AUTH_MODE=local
VITE_API_BASE_URL=/api
# Keep this equal to NAV_PUBLIC_APP_ORIGIN. The secondary login domain remains
# usable, while every newly copied public-share URL uses the canonical origin.
VITE_PUBLIC_APP_ORIGIN=https://nav.skrskr.net
