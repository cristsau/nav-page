{
  "manifest_version": 3,
  "name": "DOMO NAV Quick Add",
  "version": "1.1.0",
  "description": "一键把当前网页添加到 DOMO NAV，并记住上次使用的分组。",
  "permissions": [
    "storage",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://nav.skrskr.net/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "添加到 DOMO NAV",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "quick-add-last-group": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "一键添加当前网页到上次使用的分组"
    }
  }
}
