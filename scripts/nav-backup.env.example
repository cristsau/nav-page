# Copy this file to /etc/nav/nav-backup.env, adjust the paths, then:
#   chown root:root /etc/nav/nav-backup.env
#   chmod 600 /etc/nav/nav-backup.env
#
# Lists use semicolons. Paths must be absolute and must not contain newlines.

NAV_BACKUP_ROOT=/var/backups/nav
NAV_BACKUP_LOCK_FILE=/run/lock/nav-backup.lock
NAV_RESTORE_LOCK_FILE=/run/lock/nav-restore-rehearsal.lock
NAV_REHEARSAL_REPORT_DIR=/var/backups/nav-rehearsal-reports
NAV_RESTIC_EVIDENCE_DIR=/var/backups/nav-restic-evidence
NAV_RESTIC_CACHE_DIR=/var/cache/nav-restic

NAV_DB_CONTAINER=nav-postgres
NAV_DB_NAME=nav
NAV_DB_USER=nav
# One long-lived read-only transaction exports the snapshot used by pg_dump,
# the complete public-table set, every table count, schema_migrations evidence,
# and the attachment URL inventory. Fail rather than silently use a new
# snapshot if PostgreSQL does not return the export identifier in this time.
NAV_PG_SNAPSHOT_TIMEOUT_SECONDS=30

# Replace REPLACE_WITH_RELEASE with the currently accepted OVH release. A
# production release must update these paths before the old release is pruned.
NAV_PROJECT_DIR=/opt/nav-stack/releases/REPLACE_WITH_RELEASE
NAV_FRONTEND_DIR=/opt/nav-stack/releases/REPLACE_WITH_RELEASE/frontend-dist
NAV_COMPOSE_PATHS=/opt/nav-stack/releases/REPLACE_WITH_RELEASE/docker-compose.backend.yml
NAV_NGINX_PATHS=/opt/nav-stack/releases/REPLACE_WITH_RELEASE/ovh/nginx.conf
NAV_ENV_PATHS=/opt/nav-stack/releases/REPLACE_WITH_RELEASE/api/.env
NAV_EXTRA_CONFIG_PATHS=
# Use the exact live names returned by docker ps; do not guess them.
NAV_RUNTIME_CONTAINERS="REPLACE_NAV_API_CONTAINER;REPLACE_NAV_POSTGRES_CONTAINER"
NAV_REQUIRE_ALL_INPUTS=true

# Local deletion is disabled unless both this value is true and --prune-local
# is supplied. A candidate must be older than NAV_LOCAL_KEEP_DAYS and outside
# the newest NAV_LOCAL_KEEP_COUNT backups.
NAV_ENABLE_LOCAL_PRUNE=false
NAV_LOCAL_KEEP_DAYS=30
NAV_LOCAL_KEEP_COUNT=14

# Failure alerts are disabled by default. The credential file must be a
# regular, non-symlink file owned by the invoking user and have mode 600.
# Its only accepted keys are TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID.
NAV_ENABLE_TELEGRAM_ALERTS=false
NAV_TELEGRAM_CREDENTIAL_FILE=/etc/nav/backup-telegram.env
NAV_TELEGRAM_TIMEOUT_SECONDS=10

# Cloud upload is restic-only so the repository receives encrypted objects,
# never a plaintext archive. The environment file must have mode 600 and may
# contain only RESTIC_REPOSITORY, RESTIC_PASSWORD_FILE, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN, and AWS_DEFAULT_REGION.
NAV_ENABLE_CLOUD_UPLOAD=false
NAV_RESTIC_ENV_FILE=/etc/nav/restic-r2.env
# Exact restic snapshot IDs and the captured JSON summary are written to
# NAV_RESTIC_EVIDENCE_DIR after the new snapshot and manifest are verified.
NAV_RESTIC_TAG=domo-nav
NAV_RESTIC_RUN_CHECK=true

# The scheduled restore rehearsal must prove that an exact encrypted offsite
# snapshot can be downloaded and restored. Keep this disabled until restic,
# the R2 credentials, and one manual cloud restore have all been verified.
NAV_ENABLE_CLOUD_RESTORE_REHEARSAL=false
NAV_CLOUD_RESTORE_ROOT=/var/backups/nav-cloud-restore
NAV_CLOUD_REHEARSAL_MAX_SNAPSHOT_AGE_HOURS=48

# Remote retention is disabled unless both this value is true and
# --forget-cloud is supplied together with --cloud-upload.
NAV_ENABLE_RESTIC_FORGET=false
NAV_RESTIC_KEEP_DAILY=14
NAV_RESTIC_KEEP_WEEKLY=8
NAV_RESTIC_KEEP_MONTHLY=12

# Restore rehearsal validates checksums and pg_restore -l by default.
# Starting the isolated, network-less PostgreSQL container requires this value
# plus the --run-isolated flag. The image must already exist locally.
NAV_ENABLE_RESTORE_CONTAINER=false
NAV_RESTORE_POSTGRES_IMAGE=postgres:16-alpine
NAV_RESTORE_TMPFS_SIZE=1g
NAV_RESTORE_READY_ATTEMPTS=30
NAV_RESTORE_READY_INTERVAL_SECONDS=2
NAV_RESTORE_SCRIPT=/usr/local/sbin/nav-restore-rehearsal
# The manual local selector refuses to bless a stale backup. The independent
# cloud selector uses NAV_CLOUD_REHEARSAL_MAX_SNAPSHOT_AGE_HOURS above.
NAV_REHEARSAL_MAX_BACKUP_AGE_HOURS=48

# May also be enabled with --dry-run. Dry-run performs no dump, copy, cloud
# operation, deletion, or restore container start.
NAV_DRY_RUN=false
