# Copy to /etc/nav/nav-heartbeat.env, replace both URLs, then set owner root
# and mode 600. Each URL is a bearer-like secret issued by an independent
# dead-man service. Never commit a real URL or place one in a systemd unit.

NAV_BACKUP_HEARTBEAT_URL=https://heartbeat.example.invalid/replace-backup-id
NAV_RESTORE_HEARTBEAT_URL=https://heartbeat.example.invalid/replace-restore-id
NAV_HEARTBEAT_TIMEOUT_SECONDS=10
