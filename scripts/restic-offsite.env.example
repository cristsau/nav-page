# Copy to /etc/nav/restic-offsite.env only after choosing an object-storage
# provider. Keep this template blank in Git and fill real values on the server.
# The installed file must be root-owned, a regular non-symlink file, mode 600.

# Generic S3-compatible form. Examples include Cloudflare R2, Backblaze B2 S3,
# Wasabi, MinIO, and provider-hosted S3-compatible storage.
RESTIC_REPOSITORY=s3:https://REPLACE_WITH_S3_ENDPOINT/REPLACE_WITH_BUCKET/nav
RESTIC_PASSWORD_FILE=/etc/nav/restic-password
AWS_ACCESS_KEY_ID=REPLACE_ON_SERVER
AWS_SECRET_ACCESS_KEY=REPLACE_ON_SERVER
AWS_DEFAULT_REGION=auto

# Optional short-lived credentials only. Remove this line when unused.
# AWS_SESSION_TOKEN=REPLACE_ON_SERVER
