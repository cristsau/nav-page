{
  "name": "@nav-page/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "verify:migrations": "node src/db/verifyMigrations.js",
    "prewarm:embeddings": "node scripts/prewarmEmbeddings.js",
    "test": "node --test",
    "test:restore:integration": "node --test --test-concurrency=1 integration/dataRestorePostgres.integration.js",
    "test:maintenance:integration": "node --test --test-concurrency=1 integration/maintenancePostgres.integration.js",
    "test:advanced:integration": "node --test --test-concurrency=1 integration/advancedFeaturesPostgres.integration.js",
    "test:assistant-agent:integration": "node --test --test-concurrency=1 integration/assistantAgentPostgres.integration.js",
    "test:collaboration:integration": "node --test --test-concurrency=1 integration/collaborationOfflinePostgres.integration.js",
    "test:email-mailbox:integration": "node --test --test-concurrency=1 integration/emailMailboxPostgres.integration.js",
    "test:release-acceptance:integration": "node --test --test-concurrency=1 integration/releaseAcceptancePostgres.integration.js",
    "test:release-backlog-guard:integration": "node --test --test-concurrency=1 integration/releaseMailBacklogGuardPostgres.integration.js",
    "test:backup-gate:integration": "node --test --test-concurrency=1 integration/backupGatePostgres.integration.js",
    "test:workspace-database:integration": "node --test --test-concurrency=1 integration/workspaceDatabasePostgres.integration.js",
    "test:assistant-advanced:integration": "node --test --test-concurrency=1 integration/assistantAdvancedPostgres.integration.js"
  },
  "dependencies": {
    "@tiptap/y-tiptap": "3.0.9",
    "@y/websocket-server": "0.1.1",
