    "@huggingface/transformers": "4.2.0",
    "@simplewebauthn/server": "^13.3.2",
    "fastify": "5.12.1",
    "fastify-plugin": "^5.0.1",
    "imapflow": "1.7.6",
    "mailparser": "3.9.16",
    "nodemailer": "9.0.5",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.16.3",
    "saxes": "6.0.0",
    "web-push": "3.6.7",
    "ws": "8.21.3",
    "yauzl": "3.4.0",
    "yjs": "13.6.32"
  }
