NODE_ENV=production
PORT=3001
HOST=0.0.0.0
NAV_LOG_LEVEL=warn
DATABASE_URL=postgres://nav:nav_password@nav-postgres:5432/nav
SESSION_COOKIE_NAME=nav_session
SESSION_TTL_DAYS=14
SESSION_COOKIE_SECURE=true
SESSION_TOUCH_INTERVAL_SECONDS=300
SESSION_CLEANUP_INTERVAL_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# A successful Passkey flow makes three bounded requests (options IP + identity,
# then verify IP), so this separate persistent bucket defaults to 30.
AUTH_PASSKEY_RATE_LIMIT_MAX=30
AUTH_PASSKEY_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_RECOVERY_RATE_LIMIT_MAX=5
AUTH_RECOVERY_RATE_LIMIT_WINDOW_SECONDS=1800
AUTHENTICATED_WRITE_RATE_LIMIT_MAX=120
AUTHENTICATED_WRITE_RATE_LIMIT_WINDOW_SECONDS=60
# Required for every API service process. Generate one random value of at least
# 32 characters and keep it only in the owner-readable server environment file.
NAV_RATE_LIMIT_KEY_SECRET=
# Disabled until a current database backup and a retention dry-run have been
# reviewed. Routine successes use 90 days, denied/failed logins use 180 days,
# and recovery/admin/security-sensitive events use 365 days.
NAV_SECURITY_EVENT_RETENTION_ENABLED=false
NAV_SECURITY_EVENT_ROUTINE_RETENTION_DAYS=90
NAV_SECURITY_EVENT_DENIED_RETENTION_DAYS=180
NAV_SECURITY_EVENT_CRITICAL_RETENTION_DAYS=365
NAV_SECURITY_EVENT_RETENTION_INTERVAL_SECONDS=21600
NAV_SECURITY_EVENT_RETENTION_BATCH_SIZE=500
NAV_SECURITY_EVENT_RETENTION_MAX_BATCHES_PER_RUN=20
# Background retries are bounded, serialized across replicas, and revalidate
# references before every upstream deletion. Keep disabled until the first
# production release has been observed with the current image-library token.
NAV_MEDIA_DELETE_RETRY_ENABLED=false
NAV_MEDIA_DELETE_RETRY_INTERVAL_SECONDS=3600
NAV_MEDIA_DELETE_RETRY_BATCH_SIZE=10
NAV_MEDIA_DELETE_RETRY_MAX_ATTEMPTS=8
NAV_MEDIA_DELETE_RETRY_BASE_BACKOFF_SECONDS=900
NAV_MEDIA_DELETE_RETRY_MAX_BACKOFF_SECONDS=86400
# Advance reminders are generated in bounded database batches.
NAV_NOTE_REMINDER_SCHEDULER_ENABLED=false
NAV_NOTE_REMINDER_SCHEDULER_INTERVAL_SECONDS=60
NAV_NOTE_REMINDER_SCHEDULER_BATCH_SIZE=500

# BM25 is local and enabled by default. Semantic vectors use a local multilingual
# Transformers.js model; the model cache is mounted as a Docker volume.
NAV_HYBRID_SEARCH_ENABLED=true
NAV_SEMANTIC_SEARCH_ENABLED=false
NAV_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
NAV_EMBEDDING_MODEL_REVISION=2c4055b12046f11709e9df2c122e59ffbdc2f900
NAV_EMBEDDING_CACHE_DIR=/var/cache/nav-models
NAV_EMBEDDING_SCHEDULER_ENABLED=false
NAV_EMBEDDING_SCHEDULER_INTERVAL_SECONDS=300
NAV_EMBEDDING_SCHEDULER_BATCH_SIZE=24

# Web Push is opt-in per browser. Keep the VAPID private key in the mounted
# read-only secret file; never place it in this environment file or Git.
NAV_WEB_PUSH_ENABLED=false
NAV_WEB_PUSH_VAPID_SUBJECT=https://nav.skrskr.net
NAV_WEB_PUSH_VAPID_PUBLIC_KEY=
NAV_WEB_PUSH_VAPID_PRIVATE_KEY_FILE=/run/secrets/nav/web-push-vapid-private-key
NAV_WEB_PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,push.services.mozilla.com,updates.push.services.mozilla.com,web.push.apple.com,notify.windows.com
NAV_WEB_PUSH_SCHEDULER_ENABLED=false
NAV_WEB_PUSH_SCHEDULER_INTERVAL_SECONDS=60
NAV_WEB_PUSH_SCHEDULER_BATCH_SIZE=100
NAV_WEB_PUSH_MAX_ATTEMPTS=6
# Link checks reuse the same DNS pinning, private-address rejection and short
# probe deadline as manual checks. Enable only after observing manual results.
NAV_BOOKMARK_HEALTH_SCHEDULER_ENABLED=false
NAV_BOOKMARK_HEALTH_SCHEDULER_INTERVAL_SECONDS=3600
NAV_BOOKMARK_HEALTH_SCHEDULER_BATCH_SIZE=20
NAV_BOOKMARK_HEALTH_SCHEDULER_STALE_HOURS=168
NAV_BOOKMARK_HEALTH_SCHEDULER_CONCURRENCY=4
# Runtime failure alerts reuse each enabled administrator's Telegram target.
# They contain only the task label, a bounded error code and timestamps.
NAV_MAINTENANCE_ALERTS_ENABLED=false
NAV_MAINTENANCE_ALERT_FAILURE_THRESHOLD=3
NAV_MAINTENANCE_ALERT_COOLDOWN_SECONDS=21600
# Passkeys are intentionally disabled by default. When enabled, ceremonies are
# accepted only on https://nav.skrskr.net with RP ID nav.skrskr.net. The
# nav.cristsau.cn alias remains password-login only.
NAV_WEBAUTHN_ENABLED=false
# Daily AI aggregates contain counts, token totals and latency only; prompts and
# answers are never stored. Keep cleanup disabled until the first backup and
# dry-run review, then retain a bounded history (default 400 days).
NAV_AI_USAGE_RETENTION_ENABLED=false
NAV_AI_USAGE_RETENTION_DAYS=400
NAV_AI_USAGE_RETENTION_INTERVAL_SECONDS=86400
NAV_AI_USAGE_RETENTION_BATCH_SIZE=500
NAV_AI_USAGE_RETENTION_MAX_BATCHES_PER_RUN=20
# Optional, non-secret price catalog. Without a matching entry the UI displays
# cost as unknown instead of inventing a price. Keys may be provider:model,
# model, provider:* or *. Example schema only (fill with current verified rates):
# {"chatgpt:gpt-example":{"inputPerMillionUsd":0,"cachedInputPerMillionUsd":0,"outputPerMillionUsd":0}}
NAV_AI_PRICE_CATALOG_JSON={}
# Comma-separated exact IPs for every known proxy hop that may appear at the
# trusted end of X-Forwarded-For. Loopback is always trusted. Never use
# 0.0.0.0/0, trustProxy=true or a broad Docker/private network here.
TRUSTED_PROXY_ADDRESSES=
CORS_ORIGIN=https://nav.skrskr.net,https://nav.cristsau.cn
ALLOW_PRIVATE_AI_ENDPOINTS=false
ALLOW_INSECURE_AI_ENDPOINTS=false
NAV_AI_CLI_PROXY_BASE_URL=
NAV_AI_CLI_PROXY_API_MODE=chat-completions
NAV_AI_CLI_PROXY_API_KEY_FILE=/run/secrets/nav/cli-proxy-api-key
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
NAV_IMGBED_BASE_URL=https://pic.example.com
# Server-only upload token with upload permission and an allowed nav-notes path.
NAV_IMGBED_UPLOAD_TOKEN=
# Owner-only regular file mounted read-only by docker-compose.backend.yml. This
# separate token has list + delete permissions but no upload/manage/folder-delete.
# On the host, set the required Compose variable NAV_SECRETS_DIR to the active
# release-local secrets directory; never hard-code a global /opt/nav/secrets path.
NAV_IMGBED_LIBRARY_TOKEN_FILE=/run/secrets/nav/imgbed-library-token
NAV_IMGBED_UPLOAD_FOLDER=nav-notes
NAV_IMGBED_MAX_IMAGE_BYTES=10485760
# Canonical public-share origin. nav.cristsau.cn remains a supported login
# alias, but copied share links and canonical/OG URLs use this primary origin.
NAV_PUBLIC_APP_ORIGIN=https://nav.skrskr.net
NAV_FRONTEND_INDEX_PATH=/var/www/nav/index.html
