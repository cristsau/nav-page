NODE_ENV=production
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgres://nav:nav_password@nav-postgres:5432/nav
SESSION_COOKIE_NAME=nav_session
SESSION_TTL_DAYS=14
SESSION_COOKIE_SECURE=true
SESSION_TOUCH_INTERVAL_SECONDS=300
SESSION_CLEANUP_INTERVAL_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_RECOVERY_RATE_LIMIT_MAX=5
AUTH_RECOVERY_RATE_LIMIT_WINDOW_SECONDS=1800
AUTHENTICATED_WRITE_RATE_LIMIT_MAX=120
AUTHENTICATED_WRITE_RATE_LIMIT_WINDOW_SECONDS=60
# Required for every API service process. Generate one random value of at least
# 32 characters and keep it only in the owner-readable server environment file.
NAV_RATE_LIMIT_KEY_SECRET=
# Comma-separated exact IPs for every known proxy hop that may appear at the
# trusted end of X-Forwarded-For. Loopback is always trusted. Never use
# 0.0.0.0/0, trustProxy=true or a broad Docker/private network here.
TRUSTED_PROXY_ADDRESSES=
CORS_ORIGIN=https://nav.skrskr.net,https://nav.cristsau.cn
ALLOW_PRIVATE_AI_ENDPOINTS=false
ALLOW_INSECURE_AI_ENDPOINTS=false
NAV_AI_CLI_PROXY_BASE_URL=
NAV_AI_CLI_PROXY_API_MODE=chat-completions
NAV_AI_CLI_PROXY_API_KEY_FILE=/run/secrets/nav/cli-proxy-api-key
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
NAV_IMGBED_BASE_URL=https://pic.example.com
# Server-only upload token with upload permission and an allowed nav-notes path.
NAV_IMGBED_UPLOAD_TOKEN=
# Owner-only regular file mounted read-only by docker-compose.backend.yml. This
# separate token has list + delete permissions but no upload/manage/folder-delete.
# On the host, set the required Compose variable NAV_SECRETS_DIR to the active
# release-local secrets directory; never hard-code a global /opt/nav/secrets path.
NAV_IMGBED_LIBRARY_TOKEN_FILE=/run/secrets/nav/imgbed-library-token
NAV_IMGBED_UPLOAD_FOLDER=nav-notes
NAV_IMGBED_MAX_IMAGE_BYTES=10485760
# Canonical public-share origin. nav.cristsau.cn remains a supported login
# alias, but copied share links and canonical/OG URLs use this primary origin.
NAV_PUBLIC_APP_ORIGIN=https://nav.skrskr.net
NAV_FRONTEND_INDEX_PATH=/var/www/nav/index.html
