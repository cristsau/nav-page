NODE_ENV=production
PORT=3001
HOST=0.0.0.0
NAV_LOG_LEVEL=warn
# Required in production. Use the same database/user/password selected for the
# Compose PostgreSQL service; keep the credential only in this owner-only file.
DATABASE_URL=
# Defaults are role-aware: 6 for API-only and 12 for worker/combined. Each active
# mailbox ingest keeps two PostgreSQL sessions long-lived; the worker requires
# max(8, 2 * active_mailboxes + 4), otherwise startup/config refresh fails closed.
NAV_DATABASE_POOL_MAX=
SESSION_COOKIE_NAME=nav_session
SESSION_TTL_DAYS=14
SESSION_COOKIE_SECURE=true
# Keep lax for normal same-site browser use. Use none only when an explicitly
# allowlisted extension origin must send the session cookie cross-site.
NAV_SESSION_COOKIE_SAME_SITE=lax
SESSION_TOUCH_INTERVAL_SECONDS=300
SESSION_CLEANUP_INTERVAL_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# A successful Passkey flow makes three bounded requests (options IP + identity,
# then verify IP), so this separate persistent bucket defaults to 30.
AUTH_PASSKEY_RATE_LIMIT_MAX=30
AUTH_PASSKEY_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_RECOVERY_RATE_LIMIT_MAX=5
AUTH_RECOVERY_RATE_LIMIT_WINDOW_SECONDS=1800
AUTHENTICATED_WRITE_RATE_LIMIT_MAX=120
AUTHENTICATED_WRITE_RATE_LIMIT_WINDOW_SECONDS=60
# Required for every API service process. Generate one random value of at least
# 32 characters and keep it only in the owner-readable server environment file.
NAV_RATE_LIMIT_KEY_SECRET=
# Disabled until a current database backup and a retention dry-run have been
# reviewed. Routine successes use 90 days, denied/failed logins use 180 days,
# and recovery/admin/security-sensitive events use 365 days.
NAV_SECURITY_EVENT_RETENTION_ENABLED=false
NAV_SECURITY_EVENT_ROUTINE_RETENTION_DAYS=90
NAV_SECURITY_EVENT_DENIED_RETENTION_DAYS=180
NAV_SECURITY_EVENT_CRITICAL_RETENTION_DAYS=365
NAV_SECURITY_EVENT_RETENTION_INTERVAL_SECONDS=21600
NAV_SECURITY_EVENT_RETENTION_BATCH_SIZE=500
NAV_SECURITY_EVENT_RETENTION_MAX_BATCHES_PER_RUN=20
# Background retries are bounded, serialized across replicas, and revalidate
# references before every upstream deletion. Keep disabled until the first
# production release has been observed with the current image-library token.
NAV_MEDIA_DELETE_RETRY_ENABLED=false
NAV_MEDIA_DELETE_RETRY_INTERVAL_SECONDS=3600
NAV_MEDIA_DELETE_RETRY_BATCH_SIZE=10
NAV_MEDIA_DELETE_RETRY_MAX_ATTEMPTS=8
NAV_MEDIA_DELETE_RETRY_BASE_BACKOFF_SECONDS=900
NAV_MEDIA_DELETE_RETRY_MAX_BACKOFF_SECONDS=86400
# Advance reminders are generated in bounded database batches.
NAV_NOTE_REMINDER_SCHEDULER_ENABLED=false
NAV_NOTE_REMINDER_SCHEDULER_INTERVAL_SECONDS=60
NAV_NOTE_REMINDER_SCHEDULER_BATCH_SIZE=500

# BM25 is local and enabled by default. Semantic vectors use a local multilingual
# Transformers.js model; the model cache is mounted as a Docker volume.
NAV_HYBRID_SEARCH_ENABLED=true
NAV_SEMANTIC_SEARCH_ENABLED=false
NAV_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
NAV_EMBEDDING_MODEL_REVISION=2c4055b12046f11709e9df2c122e59ffbdc2f900
NAV_EMBEDDING_CACHE_DIR=/var/cache/nav-models
NAV_EMBEDDING_SCHEDULER_ENABLED=false
NAV_EMBEDDING_SCHEDULER_INTERVAL_SECONDS=300
NAV_EMBEDDING_SCHEDULER_BATCH_SIZE=24

# Web Push is opt-in per browser. Keep the VAPID private key in the mounted
# read-only secret file; never place it in this environment file or Git.
NAV_WEB_PUSH_ENABLED=false
NAV_WEB_PUSH_VAPID_SUBJECT=https://nav.skrskr.net
NAV_WEB_PUSH_VAPID_PUBLIC_KEY=
NAV_WEB_PUSH_VAPID_PRIVATE_KEY_FILE=/run/secrets/nav/web-push-vapid-private-key
NAV_WEB_PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,push.services.mozilla.com,updates.push.services.mozilla.com,web.push.apple.com,notify.windows.com
NAV_WEB_PUSH_SCHEDULER_ENABLED=false
NAV_WEB_PUSH_SCHEDULER_INTERVAL_SECONDS=60
NAV_WEB_PUSH_SCHEDULER_BATCH_SIZE=100
NAV_WEB_PUSH_MAX_ATTEMPTS=6
# Link checks reuse the same DNS pinning, private-address rejection and short
# probe deadline as manual checks. Enable only after observing manual results.
NAV_BOOKMARK_HEALTH_SCHEDULER_ENABLED=false
NAV_BOOKMARK_HEALTH_SCHEDULER_INTERVAL_SECONDS=3600
NAV_BOOKMARK_HEALTH_SCHEDULER_BATCH_SIZE=20
NAV_BOOKMARK_HEALTH_SCHEDULER_STALE_HOURS=168
NAV_BOOKMARK_HEALTH_SCHEDULER_CONCURRENCY=2
# Runtime failure alerts use the in-app notification center, generic Web Push,
# and (except for the SMTP worker itself) the configured outbound mailbox.
# They contain only the task label, a bounded error code and timestamps.
NAV_MAINTENANCE_ALERTS_ENABLED=false
NAV_MAINTENANCE_ALERT_FAILURE_THRESHOLD=3
NAV_MAINTENANCE_ALERT_COOLDOWN_SECONDS=21600
NAV_MAIL_WORKER_POOL_WAIT_ALERT_SECONDS=60
# Passkeys are intentionally disabled by default. When enabled, the exact
# nav.skrskr.net and nav.cristsau.cn origins are allowed. Each domain has its
# own RP ID and therefore needs a separate Passkey enrollment.
NAV_WEBAUTHN_ENABLED=false
# Daily AI aggregates contain counts, token totals and latency only; prompts and
# answers are never stored. Keep cleanup disabled until the first backup and
# dry-run review, then retain a bounded history (default 400 days).
NAV_AI_USAGE_RETENTION_ENABLED=false
NAV_AI_USAGE_RETENTION_DAYS=400
NAV_AI_USAGE_RETENTION_INTERVAL_SECONDS=86400
NAV_AI_USAGE_RETENTION_BATCH_SIZE=500
NAV_AI_USAGE_RETENTION_MAX_BATCHES_PER_RUN=4
# Optional, non-secret price catalog. Without a matching entry the UI displays
# cost as unknown instead of inventing a price. Keys may be provider:model,
# model, provider:* or *. Example schema only (fill with current verified rates):
# {"chatgpt:gpt-example":{"inputPerMillionUsd":0,"cachedInputPerMillionUsd":0,"outputPerMillionUsd":0}}
NAV_AI_PRICE_CATALOG_JSON={}
# Comma-separated exact IPs for every known proxy hop that may appear at the
# trusted end of X-Forwarded-For. Loopback is always trusted. Never use
# 0.0.0.0/0, trustProxy=true or a broad Docker/private network here.
TRUSTED_PROXY_ADDRESSES=
CORS_ORIGIN=https://nav.skrskr.net,https://nav.cristsau.cn
# Exact comma-separated chrome-extension:// IDs only. Empty rejects every
# browser extension origin; do not add a wildcard or a generic extension ID.
NAV_EXTENSION_ORIGINS=
ALLOW_PRIVATE_AI_ENDPOINTS=false
ALLOW_INSECURE_AI_ENDPOINTS=false
NAV_AI_CLI_PROXY_BASE_URL=
NAV_AI_CLI_PROXY_API_MODE=chat-completions
NAV_AI_CLI_PROXY_API_KEY_FILE=/run/secrets/nav/cli-proxy-api-key
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
NAV_IMGBED_BASE_URL=https://pic.example.com
# Server-only upload token with upload permission and an allowed nav-notes path.
NAV_IMGBED_UPLOAD_TOKEN=
# Owner-only regular file mounted read-only by docker-compose.backend.yml. This
# separate token has list + delete permissions but no upload/manage/folder-delete.
# On the host, set the required Compose variable NAV_SECRETS_DIR to the active
# release-local secrets directory; never hard-code a global /opt/nav/secrets path.
NAV_IMGBED_LIBRARY_TOKEN_FILE=/run/secrets/nav/imgbed-library-token
NAV_IMGBED_UPLOAD_FOLDER=nav-notes
NAV_IMGBED_MAX_IMAGE_BYTES=10485760
# Canonical public-share origin. nav.cristsau.cn remains a supported login
# alias, but copied share links and canonical/OG URLs use this primary origin.
NAV_PUBLIC_APP_ORIGIN=https://nav.skrskr.net
NAV_FRONTEND_INDEX_PATH=/var/www/nav/index.html

# MXroute outbound mail. Cloudflare continues to host DNS; use the exact server
# name shown by MXroute (normally the host targeted by the primary MX record).
# The SMTP username is the full mailbox address. Keep the mailbox password in
# the owner-only mounted file, never in this environment file or Git.
NAV_MAIL_DELIVERY_ENABLED=false
NAV_MAIL_DELIVERY_INTERVAL_SECONDS=30
NAV_MAIL_DELIVERY_BATCH_SIZE=25
NAV_MAIL_DELIVERY_MAX_ATTEMPTS=8
NAV_SMTP_HOST=
NAV_SMTP_PORT=465
NAV_SMTP_SECURE=true
NAV_SMTP_USERNAME=
NAV_SMTP_PASSWORD_FILE=/run/secrets/nav/smtp-password
NAV_SMTP_FROM_ADDRESS=
NAV_SMTP_FROM_NAME=DOMO NAV
NAV_ADMIN_EMAIL_RECIPIENTS=

# New-account email verification and approval result messages. Enable only
# after SMTP delivery has passed a real send/receive test.
NAV_REGISTRATION_EMAIL_ENABLED=false
NAV_REGISTRATION_EMAIL_VERIFICATION_MINUTES=30

# MXroute inbound IMAP ingestion. One mailbox is supported in this release.
# The mailbox owner must be an existing approved NAV username. Email bodies are
# stored only as AES-256-GCM ciphertext with a separate random 32-byte key.
# Keep "combined" for legacy single-process deployments. Compose overrides this
# to "api" for nav-api and "worker" for the dedicated mail process.
NAV_EMAIL_RUNTIME_ROLE=combined
NAV_EMAIL_INGEST_ENABLED=false
NAV_EMAIL_SOURCE_KEY=mxroute
NAV_EMAIL_OWNER_USERNAME=
NAV_EMAIL_ENCRYPTION_KEY_FILE=/run/secrets/nav/email-encryption-key
NAV_IMAP_HOST=
NAV_IMAP_PORT=993
NAV_IMAP_SECURE=true
NAV_IMAP_USERNAME=
NAV_IMAP_PASSWORD_FILE=/run/secrets/nav/imap-password
NAV_IMAP_MAILBOX=INBOX
# Synchronize user-composed messages to one uniquely discovered IMAP \\Sent
# folder only after SMTP acceptance. Keep disabled until migration 038 is
# applied and a real test message has passed. Set the exact provider path only
# when SPECIAL-USE discovery does not identify one unique Sent folder.
NAV_EMAIL_SENT_APPEND_ENABLED=false
NAV_IMAP_SENT_MAILBOX=
NAV_EMAIL_SENT_APPEND_INTERVAL_SECONDS=30
NAV_EMAIL_SENT_APPEND_BATCH_SIZE=5
NAV_EMAIL_SENT_APPEND_RETENTION_DAYS=30
NAV_IMAP_POLL_INTERVAL_SECONDS=60
NAV_IMAP_INITIAL_LOOKBACK=1000
NAV_IMAP_BATCH_SIZE=100
NAV_IMAP_MAX_MESSAGE_BYTES=524288
NAV_IMAP_DRAIN_MAX_BATCHES=10
NAV_IMAP_DRAIN_MAX_MILLISECONDS=15000
# Keep the existing INBOX IDLE connection as the primary fast path. A separate
# read-only connection periodically reconciles subscribed selectable folders.
# Both features default off so a release can enable protocol reconciliation
# first, then secondary-folder history, without changing the INBOX fast path.
NAV_IMAP_PROTOCOL_RECONCILIATION_ENABLED=false
NAV_IMAP_SECONDARY_FOLDER_SYNC_ENABLED=false
NAV_IMAP_FOLDER_SYNC_INTERVAL_SECONDS=900
NAV_IMAP_FOLDERS_PER_RUN=2
# Providers without QRESYNC require an authoritative bounded UID/flags scan.
# A larger folder fails closed instead of guessing which messages were removed.
NAV_IMAP_RECONCILE_MAX_MESSAGES=20000
NAV_IMAP_RECONCILE_BATCH_SIZE=500
NAV_IMAP_TELEMETRY_SAMPLE_SIZE=64
# Classification runs from a durable identity-only queue after the encrypted
# mailbox row commits, so slow AI providers never delay receiving later mail.
NAV_EMAIL_CLASSIFICATION_INTERVAL_SECONDS=2
NAV_EMAIL_CLASSIFICATION_BATCH_SIZE=10
NAV_EMAIL_CLASSIFICATION_MAX_ATTEMPTS=5

# Bounded NAV-local encrypted mailbox cache. This never deletes, moves or
# expunges messages on the IMAP server. Flagged and draft-marked cache rows are
# protected. One maintenance run can remove at most 200 local rows.
NAV_EMAIL_CACHE_RETENTION_ENABLED=true
NAV_EMAIL_CACHE_RETENTION_DAYS=180
NAV_EMAIL_CACHE_MAX_MESSAGES_PER_ACCOUNT=5000
NAV_EMAIL_CACHE_RETENTION_BATCH_SIZE=200
NAV_EMAIL_CACHE_RETENTION_MAX_DELETES_PER_RUN=200
NAV_EMAIL_CACHE_RETENTION_INTERVAL_SECONDS=21600
NAV_EMAIL_OUTBOX_RETENTION_DAYS=30

# Tier 2 digest notifications are generated at these local hours. They stay in
# NAV and use generic Web Push; no email content is included in a push payload.
NAV_EMAIL_DIGEST_ENABLED=false
NAV_EMAIL_DIGEST_INTERVAL_SECONDS=60
NAV_EMAIL_DIGEST_HOURS=12,20
NAV_EMAIL_DIGEST_TIME_ZONE=Asia/Shanghai
# Optional persistent, writable system-integration directory. When configured,
# administrators can set SMTP/IMAP and S3-compatible backup credentials from
# Settings. Secret values are write-only owner-mode files and are never
# returned to the browser. Mount the same absolute host path into nav-api.
NAV_MANAGED_INTEGRATIONS_DIR=/etc/nav/integrations
# Keep false for public MXroute/S3 services. Enable only when a reviewed private
# SMTP/IMAP/MinIO endpoint is intentionally required on the trusted server network.
NAV_ALLOW_PRIVATE_INTEGRATION_ENDPOINTS=false

# Authentication mail uses the system SMTP lifecycle, never the retired mailbox.
# Disabled until an owner-only, independently generated HMAC/AEAD key file exists.
NAV_EMAIL_LOGIN_ENABLED=false
NAV_EMAIL_PASSWORD_RESET_ENABLED=false
NAV_AUTH_EMAIL_KEYS_FILE=/etc/nav/integrations/auth-email-keys.json
