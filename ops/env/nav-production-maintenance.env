# Non-secret production maintenance profile. Merge these exact keys into the
# release-local api/.env after the release backup and before rebuilding nav-api.
# Missing variables remain fail-closed in api/src/config.js; this profile is the
# reviewed opt-in for the two low-risk, advisory-locked jobs below.

# Probe at most 20 bookmarks per hour, only when the previous result is seven
# days old. Two concurrent outbound probes keep load and DNS pressure bounded.
NAV_BOOKMARK_HEALTH_SCHEDULER_ENABLED=true
NAV_BOOKMARK_HEALTH_SCHEDULER_INTERVAL_SECONDS=3600
NAV_BOOKMARK_HEALTH_SCHEDULER_BATCH_SIZE=20
NAV_BOOKMARK_HEALTH_SCHEDULER_STALE_HOURS=168
NAV_BOOKMARK_HEALTH_SCHEDULER_CONCURRENCY=2

# AI usage rows contain aggregate counts/tokens/latency, not prompts or answers.
# Retain 400 days and delete at most 2,000 rows in one daily run.
NAV_AI_USAGE_RETENTION_ENABLED=true
NAV_AI_USAGE_RETENTION_DAYS=400
NAV_AI_USAGE_RETENTION_INTERVAL_SECONDS=86400
NAV_AI_USAGE_RETENTION_BATCH_SIZE=500
NAV_AI_USAGE_RETENTION_MAX_BATCHES_PER_RUN=4
