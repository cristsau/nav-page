[Unit]
Description=DOMO NAV daily encrypted offsite backup
Documentation=file:/usr/share/doc/domo-nav/NAV_BACKUP_RUNBOOK.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
OnFailure=nav-scheduled-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/nav-backup --config /etc/nav/nav-backup.env --cloud-upload
ExecStartPost=/usr/local/sbin/nav-heartbeat --config /etc/nav/nav-heartbeat.env backup
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
IOWeight=20
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/backups/nav /var/backups/nav-restic-evidence /var/backups/nav-rehearsal-reports /run/lock
